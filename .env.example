# --- Zorunlu ---
DISCORD_TOKEN=discord_bot_token_buraya

# --- Genel ayarlar (varsayılanlar genelde yeterli) ---
BOT_PREFIX=!
MUSIC_DIR=music
PLAYLISTS_DIR=playlists

# --- YouTube / yt-dlp kimlik doğrulama ---
# Cookie dosyası yolu - genelde boş bırakılır, kod cookies/cookies.txt dosyasını
# otomatik bulur (Netscape formatı olmalı, bkz. TROUBLESHOOTING.md)
# YOUTUBE_COOKIES_FILE=cookies/cookies.txt

# PO Token provider adresi - docker-compose'daki servis adıyla eşleşiyor, değiştirmeye gerek yok
POT_PROVIDER_BASE_URL=http://pot-provider:4416

# --- Opsiyonel: Coolify/CasaOS gibi platformlarda health check endpoint'i gerekiyorsa ---
# ENABLE_HEALTH_SERVER=1
# PORT=8080
