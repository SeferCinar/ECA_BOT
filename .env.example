# --- Zorunlu ---
DISCORD_TOKEN=discord_bot_token_buraya

# --- Genel ayarlar (varsayılanlar genelde yeterli) ---
BOT_PREFIX=!
MUSIC_DIR=music
PLAYLISTS_DIR=playlists
# Ses kanalında kimse kalmazsa kaç saniye sonra ayrılsın (0 = kapalı, varsayılan 300 = 5 dk)
# AUTO_LEAVE_SECONDS=300
# Otomatik ayrılınca mesaj atılacak text kanalının ID'si (boşsa mesaj atılmaz)
# AUTO_LEAVE_CHANNEL_ID=123456789012345678
# Mesaj metni; {channel} = ses kanalı adı, {minutes} = süre (dk). Boşsa varsayılan mesaj kullanılır
# AUTO_LEAVE_MESSAGE=👋 {channel} kanalında {minutes} dk kimse olmadığı için ayrıldım
# "Şimdi çalıyor" kartının atılacağı text kanalının ID'si. Boşsa son müzik komutunun
# yazıldığı kanal kullanılır (web panelinden/eklentiden eklenen şarkılar için bu ayar önerilir)
# NOW_PLAYING_CHANNEL_ID=123456789012345678

# --- YouTube / yt-dlp kimlik doğrulama ---
# Cookie dosyası yolu - genelde boş bırakılır, kod cookies/cookies.txt dosyasını
# otomatik bulur (Netscape formatı olmalı, bkz. TROUBLESHOOTING.md)
# YOUTUBE_COOKIES_FILE=cookies/cookies.txt

# PO Token provider adresi - docker-compose'daki servis adıyla eşleşiyor, değiştirmeye gerek yok
POT_PROVIDER_BASE_URL=http://pot-provider:4416

# --- Web kontrol paneli ---
# WEB_UI_TOKEN=uzun-rastgele-gizli-token
# WEB_UI_GUILD_ID=123456789012345678
# WEB_UI_SESSION_SECRET=oturum-imza-gizlisi
# ENABLE_HEALTH_SERVER=1
# PORT=8080
