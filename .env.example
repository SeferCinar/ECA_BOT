# --- Zorunlu ---
DISCORD_TOKEN=discord_bot_token_buraya

# --- Genel ayarlar (varsayılanlar genelde yeterli) ---
BOT_PREFIX=!
MUSIC_DIR=music
PLAYLISTS_DIR=playlists

# --- YouTube / yt-dlp kimlik doğrulama ---
# OAuth2 açıkken (varsayılan: true) cookie yerine hesap girişi kullanılır (bkz. TROUBLESHOOTING.md)
YOUTUBE_OAUTH2_ENABLED=true

# Kendi Google Cloud OAuth2 client bilgilerin (zorunlu değil, ama varsayılan plugin client'ı
# rate-limit'e takılırsa HTTP 400 alırsın - o zaman kendi client'ını oluşturup buraya yaz)
# https://console.cloud.google.com/apis/credentials
# YOUTUBE_OAUTH2_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_OAUTH2_CLIENT_SECRET=GOCSPX-your-client-secret

# OAuth2 kapatılırsa (false) bu devreye girer - genelde boş bırakılır,
# kod cookies/cookies.txt dosyasını otomatik bulur
# YOUTUBE_COOKIES_FILE=cookies/cookies.txt

# PO Token provider adresi - docker-compose'daki servis adıyla eşleşiyor, değiştirmeye gerek yok
POT_PROVIDER_BASE_URL=http://pot-provider:4416

# --- Opsiyonel: Coolify/CasaOS gibi platformlarda health check endpoint'i gerekiyorsa ---
# ENABLE_HEALTH_SERVER=1
# PORT=8080
